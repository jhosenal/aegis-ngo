# Copy to .env (never commit .env). Every value below is a SAFE DEFAULT. Live spend stays disabled while budgets are 0.
AEGIS_ENV=local
AEGIS_HOST=127.0.0.1
PORT=8787
AEGIS_PRODUCT_ID=AEG
AEGIS_STORAGE_MODE=sqlite-local
AEGIS_DB_PATH=./data/aegis.db
AEGIS_AUTH_MODE=demo
AEGIS_PROVIDER_MODE=stub
AEGIS_MODELS_ENABLED=false
AEGIS_GOOGLE_API_KEY=
AEGIS_GOOGLE_MODEL=
# Use a current model (docs 2026-10-09): gemini-3.8-flash (Flash) or gemini-3.5-flash-lite (Flash-Lite). Gemini 2.5 is legacy; do not use it.
# Per-seat overrides (see docs/06-engineering/AEG-ENG-007_google-adapter-spec.md): AEGIS_ROLE_<MANAGER|COORDINATOR|SPECIALIST|REVIEWER|ADVISOR>_PRIMARY_MODEL / _BACKUP_MODEL
# Google free tier: Google may use free-tier content to improve its products (pricing page, 2026-10-09). Keep tenant_private out of
# this list for any real tenant data; the default only suits the synthetic demo. Rate limits are per project and are shown in AI Studio.
AEGIS_GOOGLE_ALLOWED_DATA_CLASSES=public,tenant_private
AEGIS_GOOGLE_MIN_INTERVAL_MS=12000
AEGIS_GOOGLE_DAILY_REQUEST_CAP=200
AEGIS_REAPI_API_KEY=
AEGIS_REAPI_BASE_URL=
AEGIS_REAPI_MODEL=
AEGIS_REAPI_ALLOWED_DATA_CLASSES=public
# Which provider is tried first: google (default) or reapi. With reapi the three mode models below lead and Google is the backup.
# SOP-003: testing uses reapi (gpt-6-luna); only the hosted live revision (deploy/service.live.yaml) sets google.
AEGIS_PRIMARY_PROVIDER=reapi
# Chat modes: Auto (default), Normal, Pro, Expert. Pro, Expert and Auto's step-up are OFF until you switch them on, and then only for
# the registered users listed below. Every model here must have a published price in src/providers/model-prices.ts.
AEGIS_MODEL_NORMAL=gpt-6-luna
AEGIS_MODEL_PRO=gpt-6-sol
AEGIS_MODEL_EXPERT=claude-opus-5-5
AEGIS_PREMIUM_MODES_ENABLED=false
AEGIS_ESCALATION_ENABLED=false
# Public Assist module (AEG-PLN-003). Draft medical content stays false; it is refused when AEGIS_ENV=cloud.
AEGIS_ASSIST_ENABLED=false
AEGIS_ASSIST_DRAFT_MEDICAL=false
# In a cloud build, Assist is served only when records/releases/assist-release.json approves the exact content; preview lets a PRIVATE build show it with an "under review" banner.
AEGIS_ASSIST_PREVIEW=false
AEGIS_REGISTERED_USERS=
AEGIS_REAPI_TOKEN_PARAM=max_completion_tokens
AEGIS_PRICE_SNAPSHOT_ID=
# Safety-cap prices in micro-USD per million tokens. On the free tier use the paid-equivalent price so the budgets still bound usage.
AEGIS_PRICE_INPUT_MICRO_PER_MTOK=0
AEGIS_PRICE_OUTPUT_MICRO_PER_MTOK=0
AEGIS_PRICE_CAPTURED_AT=
AEGIS_PRICE_SOURCE=
AEGIS_BUDGET_ACCOUNT_MICRO=0
AEGIS_BUDGET_DAY_MICRO=0
AEGIS_BUDGET_TASK_MICRO=0
AEGIS_TOTAL_DEADLINE_MS=15000
AEGIS_MAX_ATTEMPTS_TOTAL=3
AEGIS_MAX_PRIMARY_ATTEMPTS=2
AEGIS_BACKOFF_BASE_MS=200
AEGIS_CIRCUIT_FAILURE_THRESHOLD=3
AEGIS_CIRCUIT_COOLDOWN_MS=30000
AEGIS_FEED_ALLOWLIST=
AEGIS_FEED_POLL_MINUTES=15

# Google sign-in for named admin accounts (S0037, S0038). The first three are needed together; leave empty to keep it off.
AEGIS_GOOGLE_LOGIN_CLIENT_ID=
AEGIS_GOOGLE_LOGIN_CLIENT_SECRET=
AEGIS_PUBLIC_BASE_URL=
# Comma-separated Google emails granted admin / Pro at every sign-in.
AEGIS_GOOGLE_LOGIN_ADMINS=
AEGIS_GOOGLE_LOGIN_PRO=
# Dashboard browser map (public build-time key; never reuse GOOGLE_API_KEY/model credentials).
# Restrict this dedicated key to Maps JavaScript API and your website HTTP referrers.
# Put local values in ignored .env.local, then npm.cmd run build:ui.
VITE_GOOGLE_MAPS_API_KEY=
# Optional for local testing (defaults to Google's DEMO_MAP_ID); set your own for production.
VITE_GOOGLE_MAPS_MAP_ID=

# Live public hazard feeds (USGS, GDACS): no key, no cost. Off by default so tests and demos never reach the network.
# AEGIS_LIVE_FEEDS=true
# AEGIS_LIVE_FEEDS_MINUTES=15

# Local computer only: the Admin Desk signs in as the local admin by itself. Ignored unless AEGIS_ENV=local (never works in the cloud).
AEGIS_LOCAL_AUTOLOGIN=
