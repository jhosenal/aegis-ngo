{
  "name": "aegis-ngo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aegis NGO - humanitarian coordination workspace (AI Builder Cup 2026 prototype). Synthetic demo data only.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "check:public-files": "node tools/check-public-files.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:browser": "playwright test",
    "start:test": "tsx src/api/main.ts",
    "migrate": "tsx src/data/migrate-cli.ts",
    "seed": "tsx src/services/seed-cli.ts",
    "dev:api": "tsx --env-file-if-exists=.env src/api/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "verify:docs": "node tools/verify-handover.mjs",
    "verify:docs:source": "node tools/verify-handover.mjs --structure-only",
    "verify:audit": "tsx tools/verify-audit.ts",
    "gate": "node tools/run-gate.mjs",
    "playwright:install": "playwright install chromium",
    "test:live": "node -e \"console.error('test:live is disabled (S0038 finding 7): it bypassed the gateway and the spend controls. Use the governed acceptance turn in S0036 step 5.'); process.exit(1)\"",
    "trace": "tsx tools/trace.ts",
    "chat:debug": "tsx --env-file-if-exists=.env tools/chat-debug.ts",
    "check:env": "tsx tools/check-env.ts",
    "keys:test": "tsx tools/keys.ts test",
    "keys:swap": "tsx tools/keys.ts swap",
    "scan:secrets": "node tools/scan-secrets.mjs",
    "smoke": "node tools/smoke-hosted.mjs",
    "ci": "node tools/ci.mjs",
    "assist:hash": "tsx tools/assist-content-hash.ts",
    "assist:release": "tsx tools/assist-release.ts",
    "users": "tsx tools/users.ts",
    "cost": "tsx tools/cost.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
