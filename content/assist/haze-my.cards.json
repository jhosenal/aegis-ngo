        "kind": "contact",
        "text": "For emergency help in Malaysia, call 999.",
        "sourceId": "SRC-APM-999"
      },
      {
        "id": "HAZE-MY-OUTDOOR",
        "kind": "do",
        "text": "Reduce outdoor physical activities",
        "sourceId": "SRC-MY-MOH-OUTDOOR",
        "condition": "Actions to take during the HAZE"
      },
      {
        "id": "HAZE-MY-INDOOR",
        "kind": "do",
        "text": "As far as possible, stay indoor. If you need to be outdoor, wear a suitable mask, such as the N95 or P100",
